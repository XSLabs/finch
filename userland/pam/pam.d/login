auth       required       pam_unix.so
account    required       pam_nologin.so
account    required       pam_unix.so
password   required       pam_unix.so
session    required       pam_launchd.so
# Required so login stops if the module cannot restore root; keychain errors
# themselves are ignored by the module.
session    required       pam_keychain.so
session    required       pam_uwtmp.so
# The console's user, for services that wait for someone at the console.
session    optional       pam_console.so
