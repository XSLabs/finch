+static int
+parse_shm_pages(const char *text, uint32_t *slots)
+{
+	char *end;
+	unsigned long long pages;
+	int page_size = getpagesize();
+
+	if (text == NULL || text[0] < '0' || text[0] > '9' || page_size <= 0 ||
+	    page_size % sizeof(uint32_t) != 0) return -1;
+	errno = 0;
+	pages = strtoull(text, &end, 10);
+	if (errno != 0 || *end != '\0' || pages > UINT32_MAX / (unsigned)page_size) return -1;
+	*slots = (uint32_t)(pages * ((unsigned)page_size / sizeof(uint32_t)));
 	return 0;
 }
 
