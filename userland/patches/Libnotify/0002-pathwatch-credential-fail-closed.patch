 /*
  * stat() or lstat() a path as a particular user/group.
  */
+static bool
+_path_is_in_tzdir(const char *path)
+{
+	size_t path_len;
+
+	if ((path == NULL) || (_global.tzdir == NULL) || (_global.tzdir_len == 0)) return false;
+
+	path_len = strlen(path);
+	if (path_len < _global.tzdir_len) return false;
+	if (strncasecmp(path, _global.tzdir, _global.tzdir_len) != 0) return false;
+
+	return (path[_global.tzdir_len] == '\0') || (path[_global.tzdir_len] == '/');
+}
+
 static int
+_path_stat_status_for_errno(int error)
+{
+	if ((error == ENOENT) || (error == ENOTDIR)) return PATH_STAT_MISSING;
+	if ((error == EACCES) || (error == EPERM)) return PATH_STAT_ACCESS;
+	return PATH_STAT_FAILED;
+}
+
+static void
+_path_stat_restore_thread_credentials(void)
+{
+	int status;
+
+	status = pthread_setugid_np(KAUTH_UID_NONE, KAUTH_GID_NONE);
+	if (status != 0)
+	{
+		NOTIFY_INTERNAL_CRASH(errno, "Unable to restore path-stat thread credentials");
+	}
+}
+
+static void
+_path_stat_restore_groups(int ngroups, gid_t *groups)
+{
+	int status;
+
+	status = syscall(SYS_initgroups, ngroups, groups, 0);
+	if (status < 0)
+	{
+		NOTIFY_INTERNAL_CRASH(errno, "Unable to restore path-stat group list");
+	}
+}
