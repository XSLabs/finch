+
+	status = notify_cancel(token);
+	T_ASSERT_EQ(status, (uint32_t)NOTIFY_STATUS_OK, "cancel the watched token");
+	T_ASSERT_EQ(pathwatch_test_open_file_count(watched_stat.st_dev, watched_stat.st_ino), 1,
+			"close this watch's file descriptor before external cancel returns");
+	T_ASSERT_FALSE(notify_is_valid_token(token), "canceled tokens are invalid at once");
+	T_ASSERT_EQ(notify_check(token, &check), (uint32_t)NOTIFY_STATUS_INVALID_TOKEN,
+			"notify_check rejects a canceled token");
+	T_ASSERT_EQ(notify_peek(token, &peek_value), (uint32_t)NOTIFY_STATUS_INVALID_TOKEN,
+			"notify_peek rejects a canceled token");
+	T_ASSERT_EQ(notify_get_state(token, &state), (uint32_t)NOTIFY_STATUS_INVALID_TOKEN,
+			"notify_get_state rejects a canceled token");
+	T_ASSERT_EQ(notify_set_state(token, 1), (uint32_t)NOTIFY_STATUS_INVALID_TOKEN,
+			"notify_set_state rejects a canceled token");
+	T_ASSERT_EQ(notify_suspend(token), (uint32_t)NOTIFY_STATUS_INVALID_TOKEN,
+			"notify_suspend rejects a canceled token");
+	T_ASSERT_EQ(notify_resume(token), (uint32_t)NOTIFY_STATUS_INVALID_TOKEN,
+			"notify_resume rejects a canceled token");
+
+	dispatch_semaphore_signal(release);
+	dispatch_sync(queue, ^{});
+	T_ASSERT_EQ(atomic_load_explicit(&pathwatch_cancel_callback_count, memory_order_relaxed),
+			0u, "the callback queued before cancel is dropped");
+
+	T_ASSERT_EQ(notify_cancel(check_token), (uint32_t)NOTIFY_STATUS_OK,
+			"cancel the check token");
+	T_ASSERT_EQ(pathwatch_test_open_file_count(watched_stat.st_dev, watched_stat.st_ino), 0,
+			"close the last path-watch file descriptor before external cancel returns");
+	T_ASSERT_POSIX_ZERO(unlink(path), "remove the watched file");
+	dispatch_release(release);
+	dispatch_release(blocked);
+	dispatch_release(queue);
+}
