+/* Vnode sources are process-local and always run on a per-watch serial queue. */
+static os_unfair_lock client_pathwatch_fd_lock = OS_UNFAIR_LOCK_INIT;
+static uint32_t client_pathwatch_fd_count;
+static os_unfair_lock client_pathwatch_generation_lock = OS_UNFAIR_LOCK_INIT;
+static uint64_t client_pathwatch_next_generation;
+
+enum {
+	CLIENT_PATH_DELETE = 0x0001,
+	CLIENT_PATH_WRITE = 0x0002,
+	CLIENT_PATH_EXTEND = 0x0004,
+	CLIENT_PATH_ATTRIB = 0x0008,
+	CLIENT_PATH_LINK = 0x0010,
+	CLIENT_PATH_RENAME = 0x0020,
+	CLIENT_PATH_REVOKE = 0x0040,
+	CLIENT_PATH_CREATE = 0x0080,
+	CLIENT_PATH_MTIME = 0x0100,
+	CLIENT_PATH_CTIME = 0x0200
+};
+
+static bool
+client_pathwatch_fd_reserve(void)
+{
+	bool result = false;
+	os_unfair_lock_lock(&client_pathwatch_fd_lock);
+	if (client_pathwatch_fd_count < CLIENT_PATHWATCH_MAX_FDS)
+	{
+		client_pathwatch_fd_count++;
+		result = true;
+	}
+	os_unfair_lock_unlock(&client_pathwatch_fd_lock);
+	return result;
+}
+
+static void
+client_pathwatch_fd_release(void)
+{
+	os_unfair_lock_lock(&client_pathwatch_fd_lock);
+	assert(client_pathwatch_fd_count > 0);
+	client_pathwatch_fd_count--;
+	os_unfair_lock_unlock(&client_pathwatch_fd_lock);
+}
+
+static uint64_t
+client_pathwatch_new_generation(void)
+{
+	uint64_t result;
+	os_unfair_lock_lock(&client_pathwatch_generation_lock);
+	result = ++client_pathwatch_next_generation;
+	if (result == 0) result = ++client_pathwatch_next_generation;
+	os_unfair_lock_unlock(&client_pathwatch_generation_lock);
+	return result;
+}
+
+static void
+client_pathwatch_retain(client_pathwatch_t *watch)
+{
+	if (watch != NULL) atomic_fetch_add_explicit(&watch->refcount, 1, memory_order_relaxed);
+}
+
+static void
+client_pathwatch_release(client_pathwatch_t *watch)
+{
+	if (watch == NULL) return;
+	if (atomic_fetch_sub_explicit(&watch->refcount, 1, memory_order_acq_rel) != 1) return;
+
+	registration_node_release(watch->registration);
+	free(watch->path);
+	if (watch->queue != NULL) dispatch_release(watch->queue);
+	if (watch->source_group != NULL) dispatch_release(watch->source_group);
+	free(watch);
+}
+
+/* One suspended timer lives for the whole watch. Its group entry begins before
+ * publication and lasts until the cancel handler has run, so cancel-and-drain
+ * cannot miss a timer being created at the same time. */
+static bool
+client_pathwatch_create_retry_timer(client_pathwatch_t *watch)
+{
+	client_pathwatch_retry_timer_t *entry;
+	dispatch_source_t source;
+
+	entry = calloc(1, sizeof(*entry));
+	if (entry == NULL)
+	{
+		errno = ENOMEM;
+		return false;
+	}
+
+	os_unfair_lock_lock(&watch->lock);
+	if (os_atomic_load(&watch->cancelled, relaxed))
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		free(entry);
+		errno = ECANCELED;
+		return false;
+	}
+	dispatch_group_enter(watch->source_group);
+	os_unfair_lock_unlock(&watch->lock);
+
+	source = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, watch->queue);
+	if (source == NULL)
+	{
+		dispatch_group_leave(watch->source_group);
+		free(entry);
+		errno = ENOMEM;
+		return false;
+	}
+
+	entry->watch = watch;
+	entry->source = source;
+	client_pathwatch_retain(watch);
+	dispatch_set_context(source, entry);
+	dispatch_source_set_event_handler_f(source, client_pathwatch_retry_timer_event);
+	dispatch_source_set_cancel_handler_f(source, client_pathwatch_retry_timer_cancel);
+	dispatch_source_set_timer(source, DISPATCH_TIME_FOREVER, DISPATCH_TIME_FOREVER, 0);
+
+	/* If cancellation raced source creation, this unpublished source owns the
+	 * group entry and must resume itself so its cancel handler can release it. */
+	os_unfair_lock_lock(&watch->lock);
+	if (os_atomic_load(&watch->cancelled, relaxed) || (watch->retry_timer != NULL))
+	{
+		entry->resumed = true;
+		os_unfair_lock_unlock(&watch->lock);
+		dispatch_resume(source);
+		dispatch_source_cancel(source);
+		errno = ECANCELED;
+		return false;
+	}
+	watch->retry_timer = entry;
+	os_unfair_lock_unlock(&watch->lock);
+	return true;
+}
+
+static void
+client_pathwatch_resume_retry_timer(client_pathwatch_t *watch)
+{
+	os_unfair_lock_lock(&watch->lock);
+	if (!os_atomic_load(&watch->cancelled, relaxed) && (watch->retry_timer != NULL) &&
+	    !watch->retry_timer->resumed)
+	{
+		watch->retry_timer->resumed = true;
+		dispatch_resume(watch->retry_timer->source);
+	}
+	os_unfair_lock_unlock(&watch->lock);
+}
+
+static void
+client_pathwatch_schedule_retry_timer(client_pathwatch_t *watch, bool retry)
+{
+	client_pathwatch_retry_timer_t *entry;
+	dispatch_time_t deadline;
+
+	os_unfair_lock_lock(&watch->lock);
+	entry = watch->retry_timer;
+	if ((entry != NULL) && entry->resumed &&
+	    !os_atomic_load(&watch->cancelled, relaxed) && os_atomic_load(&watch->active, relaxed))
+	{
+		deadline = retry ? dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC) : DISPATCH_TIME_FOREVER;
+		dispatch_source_set_timer(entry->source, deadline, DISPATCH_TIME_FOREVER,
+				retry ? (100 * NSEC_PER_MSEC) : 0);
+	}
+	os_unfair_lock_unlock(&watch->lock);
+}
+
+static void
+client_pathwatch_retry_timer_cancel(void *context)
+{
+	client_pathwatch_retry_timer_t *entry = context;
+	client_pathwatch_t *watch = entry->watch;
+
+	dispatch_group_leave(watch->source_group);
+	dispatch_release(entry->source);
+	free(entry);
+	client_pathwatch_release(watch);
+}
+
+static void
+client_pathwatch_retry_timer_event(void *context)
+{
+	client_pathwatch_retry_timer_t *entry = context;
+	client_pathwatch_t *watch = entry->watch;
+
+	if (os_atomic_load(&watch->cancelled, relaxed) || !os_atomic_load(&watch->active, relaxed)) return;
+	/* This is one-shot. The rebuild completion arms the next retry only if
+	 * checking under the caller's current credentials is still denied. */
+	client_pathwatch_schedule_retry_timer(watch, false);
+	if (watch->access_blocked) client_pathwatch_rebuild(watch);
+}
+
+static bool
+client_pathwatch_stat_equal(const struct stat *a, const struct stat *b)
+{
+	return (a->st_dev == b->st_dev) && (a->st_ino == b->st_ino) &&
+		((a->st_mode & S_IFMT) == (b->st_mode & S_IFMT));
+}
+
+static bool
+client_pathwatch_timespec_equal(struct timespec a, struct timespec b)
+{
+	return (a.tv_sec == b.tv_sec) && (a.tv_nsec == b.tv_nsec);
+}
+
+/* Returns true only when both the link name and its target can be read. */
+static bool
+client_pathwatch_sample(client_pathwatch_t *watch, struct stat *link_stat,
+			struct stat *target_stat, int *sample_error)
+{
+	if (lstat(watch->path, link_stat) != 0)
+	{
+		*sample_error = errno;
+		if ((errno == EACCES) || (errno == EPERM)) watch->access_blocked = true;
+		return false;
+	}
+	if (stat(watch->path, target_stat) != 0)
+	{
+		*sample_error = errno;
+		if ((errno == EACCES) || (errno == EPERM)) watch->access_blocked = true;
+		return false;
+	}
+	*sample_error = 0;
+	return true;
+}
