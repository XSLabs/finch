+static bool
+client_pathwatch_add_source(client_pathwatch_t *watch, const char *path, bool is_target,
+				bool follow_symlink, client_pathwatch_source_t **out_source)
+{
+	client_pathwatch_source_t *entry;
+	dispatch_source_t source;
+	struct stat sb;
+	int fd;
+	bool duplicate = false;
+
+	*out_source = NULL;
+	/* Count setup before opening anything. Cancel closes admission under the
+	 * same lock, then waits for both builders and published sources to retire. */
+	os_unfair_lock_lock(&watch->lock);
+	if (os_atomic_load(&watch->cancelled, relaxed))
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		errno = ECANCELED;
+		return false;
+	}
+	dispatch_group_enter(watch->source_group);
+	os_unfair_lock_unlock(&watch->lock);
+
+	if (!client_pathwatch_fd_reserve())
+	{
+		errno = EMFILE;
+		dispatch_group_leave(watch->source_group);
+		return false;
+	}
+	struct stat path_stat;
+	bool is_symlink = !follow_symlink && (lstat(path, &path_stat) == 0) && S_ISLNK(path_stat.st_mode);
+	fd = open(path, O_EVTONLY | O_CLOEXEC | (is_symlink ? O_SYMLINK : 0));
+	if (fd < 0)
+	{
+		if ((errno == EACCES) || (errno == EPERM)) watch->access_blocked = true;
+		client_pathwatch_fd_release();
+		dispatch_group_leave(watch->source_group);
+		return false;
+	}
+
+	if (fstat(fd, &sb) != 0)
+	{
+		close(fd);
+		client_pathwatch_fd_release();
+		dispatch_group_leave(watch->source_group);
+		return false;
+	}
+
+	/* Check aliases and reserve a descriptor slot while cancellation is excluded. */
+	os_unfair_lock_lock(&watch->lock);
+	if (os_atomic_load(&watch->cancelled, relaxed))
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		close(fd);
+		client_pathwatch_fd_release();
+		dispatch_group_leave(watch->source_group);
+		errno = ECANCELED;
+		return false;
+	}
+	for (uint32_t i = 0; i < watch->source_count; i++)
+	{
+		struct stat old_sb;
+		client_pathwatch_source_t *old = watch->sources[i];
+		if ((old != NULL) && (fstat(old->fd, &old_sb) == 0) &&
+		    (old_sb.st_dev == sb.st_dev) && (old_sb.st_ino == sb.st_ino))
+		{
+			if (is_target) old->is_target = true;
+			*out_source = old;
+			duplicate = true;
+			break;
+		}
+	}
+	if (duplicate)
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		close(fd);
+		client_pathwatch_fd_release();
+		dispatch_group_leave(watch->source_group);
+		return true;
+	}
+	if (watch->source_count >= CLIENT_PATHWATCH_MAX_SOURCES)
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		close(fd);
+		client_pathwatch_fd_release();
+		dispatch_group_leave(watch->source_group);
+		errno = EMFILE;
+		return false;
+	}
+	os_unfair_lock_unlock(&watch->lock);
+
+	entry = calloc(1, sizeof(*entry));
+	if (entry == NULL)
+	{
+		client_pathwatch_fd_release();
+		close(fd);
+		dispatch_group_leave(watch->source_group);
+		return false;
+	}
+	entry->watch = watch;
+	entry->fd = fd;
+	entry->is_target = is_target;
+	entry->is_symlink = is_symlink;
+	entry->counted = true;
+
+	source = dispatch_source_create(DISPATCH_SOURCE_TYPE_VNODE, (uintptr_t)fd,
+				CLIENT_PATHWATCH_EVENT_MASK, watch->queue);
+	if (source == NULL)
+	{
+		free(entry);
+		client_pathwatch_fd_release();
+		close(fd);
+		dispatch_group_leave(watch->source_group);
+		return false;
+	}
+
+	entry->source = source;
+	entry->source_group_entered = true;
+	client_pathwatch_retain(watch);
+	dispatch_set_context(source, entry);
+	dispatch_source_set_event_handler_f(source, client_pathwatch_source_event);
+	dispatch_source_set_cancel_handler_f(source, client_pathwatch_source_cancel);
+
+	/* Publish under the same lock used by cancellation and rebuild. */
+	os_unfair_lock_lock(&watch->lock);
+	if (os_atomic_load(&watch->cancelled, relaxed) ||
+	    (watch->source_count >= CLIENT_PATHWATCH_MAX_SOURCES))
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		entry->resumed = true;
+		dispatch_resume(source);
+		dispatch_source_cancel(source);
+		errno = os_atomic_load(&watch->cancelled, relaxed) ? ECANCELED : EMFILE;
+		return false;
+	}
+	watch->sources[watch->source_count++] = entry;
+	os_unfair_lock_unlock(&watch->lock);
+	*out_source = entry;
+	return true;
+}
+
+static bool
+client_pathwatch_build_path_sources(client_pathwatch_t *watch, const char *path,
+					unsigned symlink_depth)
+{
+	char prefix[MAXPATHLEN + 1];
+	char *cursor;
+	client_pathwatch_source_t *entry;
+
+	if ((path == NULL) || (path[0] != '/') || os_atomic_load(&watch->cancelled, relaxed))
+	{
+		errno = (path == NULL || path[0] != '/') ? EINVAL : ECANCELED;
+		return false;
+	}
+	if (symlink_depth > CLIENT_PATHWATCH_MAX_SYMLINKS)
+	{
+		errno = ELOOP;
+		return false;
+	}
+
+	if (strcmp(path, "/") == 0)
+		return client_pathwatch_add_source(watch, "/", true, false, &entry);
+	if (strlcpy(prefix, path, sizeof(prefix)) >= sizeof(prefix))
+	{
+		errno = ENAMETOOLONG;
+		return false;
+	}
+
+	cursor = prefix + 1;
+	for (;;)
+	{
+		char *end = cursor;
+		bool last;
+		bool is_symlink;
+		while ((*end != '\0') && (*end != '/')) end++;
+		last = (*end == '\0');
+		if (!last) *end = '\0';
+		if (*prefix != '\0')
+		{
+			bool target = last;
+			if (!client_pathwatch_add_source(watch, prefix, target, false, &entry))
+			{
+				/* Keep only the nearest parent the registering process can open. */
+				if ((errno == ENOENT) || (errno == ENOTDIR) || (errno == EACCES) || (errno == EPERM))
+				{
+					if (cursor == prefix + 1 && watch->source_count == 0 &&
+					    !client_pathwatch_add_source(watch, "/", false, false, &entry)) return false;
+					return true;
+				}
+				return false;
+			}
+			is_symlink = (entry != NULL) && entry->is_symlink;
+			if (is_symlink)
+			{
+				char link_target[MAXPATHLEN + 1];
+				char resolved_path[MAXPATHLEN + 1];
+				const char *suffix = last ? "" : end + 1;
+				ssize_t link_length = readlink(prefix, link_target, sizeof(link_target) - 1);
+				size_t resolved_length;
+
+				/* Follow the link text too, including targets outside the named path's tree. */
+				if (link_length < 0)
+				{
+					if ((errno == EACCES) || (errno == EPERM)) watch->access_blocked = true;
+					if ((errno == ENOENT) || (errno == ENOTDIR) || (errno == EACCES) || (errno == EPERM)) return true;
+					return false;
+				}
+				if ((size_t)link_length >= sizeof(link_target) - 1)
+				{
+					errno = ENAMETOOLONG;
+					return false;
+				}
+				link_target[link_length] = '\0';
+
+				if (link_target[0] == '/')
+				{
+					if (strlcpy(resolved_path, link_target, sizeof(resolved_path)) >= sizeof(resolved_path))
+					{
+						errno = ENAMETOOLONG;
+						return false;
+					}
+				}
+				else
+				{
+					char *slash = strrchr(prefix, '/');
+					size_t parent_length = (slash == prefix) ? 1 : (size_t)(slash - prefix);
+					if (parent_length >= sizeof(resolved_path))
+					{
+						errno = ENAMETOOLONG;
+						return false;
+					}
+					memcpy(resolved_path, prefix, parent_length);
+					resolved_path[parent_length] = '\0';
+					if ((parent_length > 0) && (resolved_path[parent_length - 1] != '/'))
+					{
+						if (strlcat(resolved_path, "/", sizeof(resolved_path)) >= sizeof(resolved_path))
+						{
+							errno = ENAMETOOLONG;
+							return false;
+						}
+					}
+					if (strlcat(resolved_path, link_target, sizeof(resolved_path)) >= sizeof(resolved_path))
+					{
+						errno = ENAMETOOLONG;
+						return false;
+					}
+				}
+
+				if (*suffix != '\0')
+				{
+					while (*suffix == '/') suffix++;
+					resolved_length = strlen(resolved_path);
+					if ((resolved_length == 0) || (resolved_path[resolved_length - 1] != '/'))
+					{
+						if (strlcat(resolved_path, "/", sizeof(resolved_path)) >= sizeof(resolved_path))
+						{
+							errno = ENAMETOOLONG;
+							return false;
+						}
+					}
+					if (strlcat(resolved_path, suffix, sizeof(resolved_path)) >= sizeof(resolved_path))
+					{
+						errno = ENAMETOOLONG;
+						return false;
+					}
+				}
+
+				if (!last && (*end == '\0')) *end = '/';
+				return client_pathwatch_build_path_sources(watch, resolved_path, symlink_depth + 1);
+			}
+		}
+		if (last) break;
+		*end = '/';
+		cursor = end + 1;
+	}
+	return true;
+}
+
+static bool
+client_pathwatch_build_sources(client_pathwatch_t *watch)
+{
+	return client_pathwatch_build_path_sources(watch, watch->path, 0);
+}
+
+static void
+client_pathwatch_cancel_sources(client_pathwatch_t *watch)
+{
+	client_pathwatch_source_t *sources[CLIENT_PATHWATCH_MAX_SOURCES];
+	bool needs_resume[CLIENT_PATHWATCH_MAX_SOURCES];
+	uint32_t count;
+
+	os_unfair_lock_lock(&watch->lock);
+	count = watch->source_count;
+	memcpy(sources, watch->sources, count * sizeof(sources[0]));
+	for (uint32_t i = 0; i < count; i++)
+	{
+		needs_resume[i] = sources[i] != NULL && !sources[i]->resumed;
+		if (sources[i] != NULL) sources[i]->resumed = true;
+	}
+	memset(watch->sources, 0, sizeof(watch->sources));
+	watch->source_count = 0;
+	os_unfair_lock_unlock(&watch->lock);
+
+	for (uint32_t i = 0; i < count; i++)
+	{
+		if (sources[i] != NULL)
+		{
+			/* A canceled suspended source still needs one resume to run its cleanup. */
+			if (needs_resume[i]) dispatch_resume(sources[i]->source);
+			dispatch_source_cancel(sources[i]->source);
+		}
+	}
+}
+
+static void
+client_pathwatch_cancel(client_pathwatch_t *watch)
+{
+	client_pathwatch_retry_timer_t *retry_timer = NULL;
+	bool resume_timer = false;
+
+	if (watch == NULL) return;
+	os_unfair_lock_lock(&watch->lock);
+	os_atomic_store(&watch->cancelled, true, relaxed);
+	os_atomic_store(&watch->active, false, relaxed);
+	retry_timer = watch->retry_timer;
+	watch->retry_timer = NULL;
+	if ((retry_timer != NULL) && !retry_timer->resumed)
+	{
+		retry_timer->resumed = true;
+		resume_timer = true;
+	}
+	os_unfair_lock_unlock(&watch->lock);
+	client_pathwatch_cancel_sources(watch);
+	if (retry_timer != NULL)
+	{
+		/* A canceled suspended timer still needs one resume for its cleanup. */
+		if (resume_timer) dispatch_resume(retry_timer->source);
+		dispatch_source_cancel(retry_timer->source);
+	}
+}
+
+/* Stop delivery and wait for work already running on this watch's serial
+ * queue. A path-watch event can be sending a signal or relaying to notifyd.
+ * Do not wait from any path-watch queue: signal handlers may cancel another
+ * watch, and two such handlers must not wait on each other. */
+static void
+client_pathwatch_cancel_and_drain(client_pathwatch_t *watch)
+{
+	if (watch == NULL) return;
+	client_pathwatch_cancel(watch);
+	if (dispatch_get_specific(&client_pathwatch_queue_key) == NULL)
+	{
+		/* Group membership starts before source creation and ends only after its
+		 * cancel handler has closed the descriptor. This includes rebuild sources
+		 * that have already left the watch's active source array. */
+		dispatch_group_wait(watch->source_group, DISPATCH_TIME_FOREVER);
+		dispatch_sync(watch->queue, ^{});
+	}
+}
+
+static void
+client_pathwatch_resume_sources(client_pathwatch_t *watch)
+{
+	client_pathwatch_source_t *sources[CLIENT_PATHWATCH_MAX_SOURCES];
+	uint32_t count = 0;
+
+	os_unfair_lock_lock(&watch->lock);
+	if (!os_atomic_load(&watch->cancelled, relaxed) && os_atomic_load(&watch->active, relaxed))
+	{
+		for (uint32_t i = 0; i < watch->source_count; i++)
+		{
+			client_pathwatch_source_t *source = watch->sources[i];
+			if ((source != NULL) && !source->resumed)
+			{
+				source->resumed = true;
+				sources[count++] = source;
+			}
+		}
+	}
+	os_unfair_lock_unlock(&watch->lock);
+
+	for (uint32_t i = 0; i < count; i++) dispatch_resume(sources[i]->source);
+}
+
+static uint32_t
+client_pathwatch_create(registration_node_t *r, char *path, int flags,
+			uint64_t generation, client_pathwatch_t **out_watch)
+{
+	client_pathwatch_t *watch;
+	char absolute_path[MAXPATHLEN + 1];
+	struct stat link_stat, target_stat;
+	int error = 0;
+
+	*out_watch = NULL;
+	if (path == NULL) return NOTIFY_STATUS_INVALID_REQUEST;
+	if ((path[0] != '/') || (strnlen(path, MAXPATHLEN) >= MAXPATHLEN))
+		return NOTIFY_STATUS_INVALID_REQUEST;
+	if (strlcpy(absolute_path, path, sizeof(absolute_path)) >= sizeof(absolute_path))
+		return NOTIFY_STATUS_INVALID_REQUEST;
+
+	/* Match the old path parser: ignore trailing separators except for root. */
+	while ((strlen(absolute_path) > 1) && (absolute_path[strlen(absolute_path) - 1] == '/'))
+		absolute_path[strlen(absolute_path) - 1] = '\0';
+
+	watch = calloc(1, sizeof(*watch));
+	if (watch == NULL) return NOTIFY_STATUS_ALLOC_FAILED;
+	atomic_init(&watch->refcount, 1);
+	atomic_init(&watch->active, false);
+	atomic_init(&watch->cancelled, false);
+	watch->registration = r;
+	registration_node_retain(r);
+	watch->path = strdup(absolute_path);
+	watch->flags = (flags == 0) ? CLIENT_PATHWATCH_ALL_FLAGS : ((uint32_t)flags & CLIENT_PATHWATCH_ALL_FLAGS);
+	watch->generation = generation;
+	watch->lock = OS_UNFAIR_LOCK_INIT;
+	watch->queue = dispatch_queue_create("com.apple.libnotify.pathwatch", DISPATCH_QUEUE_SERIAL);
+	watch->source_group = dispatch_group_create();
+	if ((watch->path == NULL) || (watch->queue == NULL) || (watch->source_group == NULL))
+	{
+		client_pathwatch_release(watch);
+		return NOTIFY_STATUS_ALLOC_FAILED;
+	}
+	dispatch_queue_set_specific(watch->queue, &client_pathwatch_queue_key, watch, NULL);
+	if (!client_pathwatch_create_retry_timer(watch))
+	{
+		uint32_t status = (errno == ENOMEM) ? NOTIFY_STATUS_ALLOC_FAILED : NOTIFY_STATUS_PATH_NODE_CREATE_FAILED;
+		client_pathwatch_cancel_and_drain(watch);
+		client_pathwatch_release(watch);
+		return status;
+	}
+
+	watch->have_snapshot = true;
+	watch->present = client_pathwatch_sample(watch, &link_stat, &target_stat, &error);
+	if (watch->present)
+	{
+		watch->link_stat = link_stat;
+		watch->target_stat = target_stat;
+	}
+
+	/* The source-open pass is the authoritative access check for monitoring. */
+	watch->access_blocked = false;
+	if (!client_pathwatch_build_sources(watch))
+	{
+		int source_error = errno;
+		client_pathwatch_cancel_and_drain(watch);
+		client_pathwatch_release(watch);
+		return (source_error == ENOMEM) ? NOTIFY_STATUS_ALLOC_FAILED : NOTIFY_STATUS_PATH_NODE_CREATE_FAILED;
+	}
+	if (watch->source_count == 0)
+	{
+		client_pathwatch_cancel_and_drain(watch);
+		client_pathwatch_release(watch);
+		return NOTIFY_STATUS_PATH_NODE_CREATE_FAILED;
+	}
+
+	*out_watch = watch;
+	return NOTIFY_STATUS_OK;
+}
+
+static void
+client_pathwatch_start(client_pathwatch_t *watch)
+{
+	os_unfair_lock_lock(&watch->lock);
+	if (!os_atomic_load(&watch->cancelled, relaxed)) os_atomic_store(&watch->active, true, relaxed);
+	os_unfair_lock_unlock(&watch->lock);
+	client_pathwatch_resume_retry_timer(watch);
+	client_pathwatch_resume_sources(watch);
+
+	/* Sources must be live before the snapshot is refreshed, or a change in
+	 * the setup gap could be missed. Serialize the comparison with callbacks. */
+	dispatch_sync(watch->queue, ^{
+		if (client_pathwatch_reconcile_after_arm(watch, false))
+		{
+			client_pathwatch_rebuild(watch);
+		}
+		else
+		{
+			client_pathwatch_schedule_retry_timer(watch, watch->access_blocked);
+		}
+	});
+}
+
+static bool
+client_pathwatch_needs_server_relay(registration_node_t *r)
+{
+	if ((r == NULL) || (r->queue != NULL && r->block != NULL)) return false;
+	switch (r->flags & NOTIFY_TYPE_MASK)
+	{
+		case NOTIFY_TYPE_FILE:
+		case NOTIFY_TYPE_PORT:
+		case NOTIFY_TYPE_COMMON_PORT:
+		case NOTIFY_TYPE_XPC_EVENT:
+			return true;
+		default:
+			return false;
+	}
+}
+
+static bool
+client_pathwatch_needs_regeneration(registration_node_t *r)
+{
+	return client_pathwatch_needs_server_relay(r) ||
+		((r != NULL) && ((r->flags & NOTIFY_TYPE_MASK) == NOTIFY_TYPE_SIGNAL));
+}
+
+static void
+client_pathwatch_signal_suspend(registration_node_t *r, bool suspend)
+{
+	bool send_pending = false;
+	int sig;
+
+	if ((r == NULL) || ((r->flags & NOTIFY_TYPE_MASK) != NOTIFY_TYPE_SIGNAL)) return;
+	sig = r->signal_or_xtra_mp;
+	os_unfair_lock_lock(&r->path_signal_lock);
+	if (suspend)
+	{
+		if (r->path_signal_suspend_count < UINT32_MAX) r->path_signal_suspend_count++;
+	}
+	else if (r->path_signal_suspend_count > 0)
+	{
+		r->path_signal_suspend_count--;
+		if ((r->path_signal_suspend_count == 0) && r->path_signal_pending)
+		{
+			r->path_signal_pending = false;
+			send_pending = true;
+		}
+	}
+	os_unfair_lock_unlock(&r->path_signal_lock);
+
+	if (send_pending && (sig > 0)) (void)kill(getpid(), sig);
+}
+
+static void
+client_pathwatch_signal_deliver(registration_node_t *r)
+{
+	bool send_signal = false;
+	int sig;
+
+	if ((r == NULL) || ((r->flags & NOTIFY_TYPE_MASK) != NOTIFY_TYPE_SIGNAL)) return;
+	sig = r->signal_or_xtra_mp;
+	os_unfair_lock_lock(&r->path_signal_lock);
+	if (r->path_signal_suspend_count != 0) r->path_signal_pending = true;
+	else send_signal = true;
+	os_unfair_lock_unlock(&r->path_signal_lock);
+
+	if (send_signal && (sig > 0)) (void)kill(getpid(), sig);
+}
+
+static uint32_t
+client_pathwatch_register_relay(registration_node_t *r, uint64_t generation)
+{
+	notify_globals_t globals = _notify_globals();
+	int32_t status = NOTIFY_STATUS_OK;
+	kern_return_t kstatus;
+
+	if (!client_pathwatch_needs_server_relay(r)) return NOTIFY_STATUS_OK;
+	if (globals->notify_server_port == MACH_PORT_NULL) return NOTIFY_STATUS_SERVER_PORT_NULL;
+
+	kstatus = _notify_server_pathwatch_register_3(globals->notify_server_port,
+							      (int)r->token, generation, &status);
+	if ((kstatus != KERN_SUCCESS) || (status != NOTIFY_STATUS_OK))
+		return NOTIFY_STATUS_SERVER_MONITOR_FILE_2_FAILED;
+	return NOTIFY_STATUS_OK;
+}
+
+static uint32_t
+client_pathwatch_stat_changes(const struct stat *old_link, const struct stat *old_target,
+			      const struct stat *new_link, const struct stat *new_target)
+{
+	uint32_t result = 0;
+	if (!client_pathwatch_stat_equal(old_link, new_link) || !client_pathwatch_stat_equal(old_target, new_target))
+		return CLIENT_PATH_DELETE | CLIENT_PATH_CREATE;
+	if (!client_pathwatch_timespec_equal(old_link->st_ctimespec, new_link->st_ctimespec))
+		result |= CLIENT_PATH_CTIME | CLIENT_PATH_ATTRIB;
+	if (!client_pathwatch_timespec_equal(old_link->st_mtimespec, new_link->st_mtimespec) ||
+	    (old_link->st_size != new_link->st_size))
+		result |= CLIENT_PATH_MTIME | CLIENT_PATH_ATTRIB;
+	if (old_link->st_nlink != new_link->st_nlink) result |= CLIENT_PATH_LINK;
+	if (!client_pathwatch_timespec_equal(old_target->st_mtimespec, new_target->st_mtimespec))
+		result |= CLIENT_PATH_MTIME | CLIENT_PATH_ATTRIB;
+	if (!client_pathwatch_timespec_equal(old_target->st_ctimespec, new_target->st_ctimespec))
+		result |= CLIENT_PATH_CTIME | CLIENT_PATH_ATTRIB;
+	if (old_target->st_size != new_target->st_size)
+	{
+		result |= CLIENT_PATH_WRITE;
+		if (new_target->st_size > old_target->st_size) result |= CLIENT_PATH_EXTEND;
+	}
+	if (old_target->st_nlink != new_target->st_nlink) result |= CLIENT_PATH_LINK;
+	if ((old_target->st_mode != new_target->st_mode) || (old_target->st_uid != new_target->st_uid) ||
+	    (old_target->st_gid != new_target->st_gid)) result |= CLIENT_PATH_ATTRIB;
+	return result;
+}
+
+/* Compare the remembered name and target with the live path after sources
+ * are armed. This closes the setup/rebuild gap where an event can happen
+ * after the previous sample but before the vnode source is listening. */
+static uint32_t
+client_pathwatch_reconcile(client_pathwatch_t *watch)
+{
+	struct stat link_stat, target_stat;
+	int sample_error = 0;
+	bool present = client_pathwatch_sample(watch, &link_stat, &target_stat, &sample_error);
+	uint32_t data = 0;
+
+	if (present)
+	{
+		if (!watch->present) data |= CLIENT_PATH_CREATE;
+		else if (watch->have_snapshot)
+			data |= client_pathwatch_stat_changes(&watch->link_stat, &watch->target_stat,
+								 &link_stat, &target_stat);
+		watch->link_stat = link_stat;
+		watch->target_stat = target_stat;
+	}
+	else if (watch->present)
+	{
+		data |= CLIENT_PATH_DELETE;
+		if ((sample_error == EACCES) || (sample_error == EPERM) ||
+		    ((sample_error != ENOENT) && (sample_error != ENOTDIR))) data |= CLIENT_PATH_REVOKE;
+	}
+
+	watch->present = present;
+	watch->have_snapshot = true;
+	return data;
+}
+
+/* A missing endpoint may gain a new directory component while sources are
+ * being installed. Extend the watched prefix once more after arming, then
+ * sample again so both changes and the new endpoint are covered. */
+static bool
+client_pathwatch_reconcile_after_arm(client_pathwatch_t *watch, bool access_restored)
+{
+	uint32_t data = client_pathwatch_reconcile(watch);
+	const uint32_t rebuild_mask = CLIENT_PATH_DELETE | CLIENT_PATH_CREATE |
+		CLIENT_PATH_RENAME | CLIENT_PATH_REVOKE;
+	if (watch->access_blocked) return false;
+	if (access_restored && watch->present && ((data & CLIENT_PATH_CREATE) == 0))
+		data |= CLIENT_PATH_CREATE;
+	if (data != 0) client_pathwatch_deliver(watch, data);
+	if (data & rebuild_mask) return true;
+	if (watch->present) return false;
+
+	if (!client_pathwatch_build_sources(watch))
+	{
+		client_pathwatch_deliver(watch, CLIENT_PATH_DELETE | CLIENT_PATH_REVOKE);
+		return false;
+	}
+	client_pathwatch_resume_sources(watch);
+	data = client_pathwatch_reconcile(watch);
+	if (watch->access_blocked) return false;
+	if (data != 0) client_pathwatch_deliver(watch, data);
+	return (data & rebuild_mask) != 0;
+}
+
+static void
+client_pathwatch_relay(client_pathwatch_t *watch, uint64_t sequence, unsigned retries)
+{
+	registration_node_t *r = watch->registration;
+	notify_globals_t globals = _notify_globals();
+	uint32_t status = NOTIFY_STATUS_OK;
+	kern_return_t kstatus;
+
+	if (!os_atomic_load(&watch->active, relaxed)) return;
+	if (regenerate_check(globals) != NOTIFY_STATUS_OK) goto retry;
+	if (globals->notify_server_port == MACH_PORT_NULL) goto retry;
+	kstatus = _notify_server_pathwatch_event_3(globals->notify_server_port, (int)r->token,
+					watch->generation, sequence, (int32_t *)&status);
+	if ((kstatus == KERN_SUCCESS) && (status == NOTIFY_STATUS_OK)) return;
+
+retry:
+	if (retries == 0) return;
+	client_pathwatch_retain(watch);
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), watch->queue, ^{
+		if (os_atomic_load(&watch->active, relaxed) && (watch->sequence == sequence))
+			client_pathwatch_relay(watch, sequence, retries - 1);
+		client_pathwatch_release(watch);
+	});
+}
+
+static void
+client_pathwatch_deliver(client_pathwatch_t *watch, uint32_t data)
+{
+	registration_node_t *r = watch->registration;
+	uint32_t type;
+
+	if ((data & watch->flags) == 0) return;
+	if (!os_atomic_load(&watch->active, relaxed)) return;
+	type = r->flags & NOTIFY_TYPE_MASK;
+	atomic_fetch_add_explicit(&r->path_event_count, 1, memory_order_relaxed);
+
+	if (r->queue != NULL && r->block != NULL)
+	{
+		_notify_dispatch_local_notification(r);
+	}
+	else if (type == NOTIFY_TYPE_SIGNAL)
+	{
+		/* Signal the registering process directly; this also works for a non-root daemon. */
+		client_pathwatch_signal_deliver(r);
+	}
+
+	if (client_pathwatch_needs_server_relay(r))
+	{
+		uint64_t sequence = ++watch->sequence;
+		if (sequence == 0) sequence = ++watch->sequence;
+		client_pathwatch_relay(watch, sequence, 5);
+	}
+}
+
+static void
+client_pathwatch_rebuild(client_pathwatch_t *watch)
+{
+	client_pathwatch_source_t *sources[CLIENT_PATHWATCH_MAX_SOURCES];
+	dispatch_group_t group;
+	uint32_t count;
+
+	os_unfair_lock_lock(&watch->lock);
+	if (!os_atomic_load(&watch->active, relaxed) || watch->rebuilding)
+	{
+		os_unfair_lock_unlock(&watch->lock);
+		return;
+	}
+	watch->rebuilding = true;
+	count = watch->source_count;
+	memcpy(sources, watch->sources, count * sizeof(sources[0]));
+	memset(watch->sources, 0, sizeof(watch->sources));
+	watch->source_count = 0;
+	os_unfair_lock_unlock(&watch->lock);
+
+	group = dispatch_group_create();
+	for (uint32_t i = 0; i < count; i++)
+	{
+		if (sources[i] == NULL) continue;
+		sources[i]->retired_group = group;
+		dispatch_retain(group);
+		dispatch_group_enter(group);
+		dispatch_source_cancel(sources[i]->source);
+	}
+
+	client_pathwatch_retain(watch);
+	dispatch_group_notify(group, watch->queue, ^{
+		bool rebuild_again = false;
+		bool access_restored = watch->access_blocked;
+		watch->access_blocked = false;
+		if (os_atomic_load(&watch->active, relaxed) && !client_pathwatch_build_sources(watch))
+		{
+			client_pathwatch_deliver(watch, CLIENT_PATH_DELETE | CLIENT_PATH_REVOKE);
+		}
+		if (os_atomic_load(&watch->active, relaxed))
+		{
+			/* Arm the rebuilt set before sampling so changes in the rebuild gap
+			 * become visible either here or in a queued vnode callback. */
+			client_pathwatch_resume_sources(watch);
+			rebuild_again = client_pathwatch_reconcile_after_arm(watch, access_restored);
+		}
+		os_unfair_lock_lock(&watch->lock);
+		watch->rebuilding = false;
+		os_unfair_lock_unlock(&watch->lock);
+		if (rebuild_again && os_atomic_load(&watch->active, relaxed))
+		{
+			client_pathwatch_retain(watch);
+			dispatch_async(watch->queue, ^{
+				client_pathwatch_rebuild(watch);
+				client_pathwatch_release(watch);
+			});
+		}
+		else
+		{
+			client_pathwatch_schedule_retry_timer(watch, watch->access_blocked);
+		}
+		client_pathwatch_release(watch);
+		dispatch_release(group);
+	});
+}
+
+static void
+client_pathwatch_source_event(void *context)
+{
+	client_pathwatch_source_t *entry = context;
+	client_pathwatch_t *watch = entry->watch;
+	struct stat link_stat, target_stat;
+	int sample_error = 0;
+	uint32_t data = 0;
+	bool present;
+
+	if (!os_atomic_load(&watch->active, relaxed) || watch->rebuilding) return;
+	present = client_pathwatch_sample(watch, &link_stat, &target_stat, &sample_error);
+	if (watch->access_blocked)
+	{
+		/* Do not relay file details while an open under the registering
+		 * process's credentials is denied. Rebuild on an ancestor event to see
+		 * whether access has returned; a quiet denied path may need polling. */
+		client_pathwatch_rebuild(watch);
+		return;
+	}
+	if (present)
+	{
+		if (!watch->present) data |= CLIENT_PATH_CREATE;
+		else data |= client_pathwatch_stat_changes(&watch->link_stat, &watch->target_stat, &link_stat, &target_stat);
+		watch->link_stat = link_stat;
+		watch->target_stat = target_stat;
+	}
+	else if (watch->present)
+	{
+		data |= CLIENT_PATH_DELETE;
+		if ((sample_error == EACCES) || (sample_error == EPERM) ||
+		    ((sample_error != ENOENT) && (sample_error != ENOTDIR))) data |= CLIENT_PATH_REVOKE;
+	}
+	else if (entry->is_target)
+	{
+		uint32_t event_data = (uint32_t)dispatch_source_get_data(entry->source);
+		if ((event_data & DISPATCH_VNODE_REVOKE) != 0) data |= CLIENT_PATH_DELETE | CLIENT_PATH_REVOKE;
+	}
+	watch->present = present;
+	watch->have_snapshot = true;
+	if (entry->is_target)
+	{
+		uint32_t event_data = (uint32_t)dispatch_source_get_data(entry->source);
+		if ((event_data & DISPATCH_VNODE_DELETE) != 0) data |= CLIENT_PATH_DELETE;
+		if ((event_data & DISPATCH_VNODE_WRITE) != 0) data |= CLIENT_PATH_WRITE;
+		if ((event_data & DISPATCH_VNODE_EXTEND) != 0) data |= CLIENT_PATH_EXTEND;
+		if ((event_data & DISPATCH_VNODE_ATTRIB) != 0) data |= CLIENT_PATH_ATTRIB;
+		if ((event_data & DISPATCH_VNODE_LINK) != 0) data |= CLIENT_PATH_LINK;
+		if ((event_data & DISPATCH_VNODE_RENAME) != 0) data |= CLIENT_PATH_RENAME | CLIENT_PATH_DELETE;
+		if ((event_data & DISPATCH_VNODE_REVOKE) != 0) data |= CLIENT_PATH_REVOKE | CLIENT_PATH_DELETE;
+	}
+	if (data != 0) client_pathwatch_deliver(watch, data);
+	if (data & (CLIENT_PATH_DELETE | CLIENT_PATH_CREATE | CLIENT_PATH_RENAME | CLIENT_PATH_REVOKE))
+	{
+		client_pathwatch_rebuild(watch);
+	}
+	else if (!present)
+	{
+		/* A directory can be created one component at a time. Keep extending
+		 * the watched prefix while the endpoint is still missing. */
+		if (client_pathwatch_build_sources(watch)) client_pathwatch_resume_sources(watch);
+	}
+}
+
+static void
+client_pathwatch_source_cancel(void *context)
+{
+	client_pathwatch_source_t *entry = context;
+	dispatch_source_t source = entry->source;
+	dispatch_group_t group = entry->retired_group;
+	client_pathwatch_t *watch = entry->watch;
+
+	close(entry->fd);
+	if (entry->counted) client_pathwatch_fd_release();
+	if (entry->source_group_entered) dispatch_group_leave(watch->source_group);
+	if (group != NULL)
+	{
+		dispatch_group_leave(group);
+		dispatch_release(group);
+	}
+	free(entry);
+	dispatch_release(source);
+	client_pathwatch_release(watch);
+}
