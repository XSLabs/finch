 static void * symAddrInSC(const char *name)
 {
+    /* Finch: Apple's SystemConfiguration is closed; nothing is loaded until
+     * Finch builds it from configd. The SC calls below then do nothing, as
+     * they do where the framework is missing. */
+    if (1) return NULL;
     static void * handle = NULL;
     
     if (!handle) {
