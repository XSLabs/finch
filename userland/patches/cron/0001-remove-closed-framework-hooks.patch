diff --git a/xcodescripts/install_misc.sh b/xcodescripts/install_misc.sh
index 9f929a7..c160e02 100644
--- a/xcodescripts/install_misc.sh
+++ b/xcodescripts/install_misc.sh
@@ -1,12 +1,13 @@
 #!/bin/sh
 set -ex
 
-install -o daemon -d "${DSTROOT}/private/var/at"
-install -m 644 "${SRCROOT}/cron.deny" "${DSTROOT}/private/var/at"
+# Finch: cron uses /usr/lib/cron for its policy file and editable job spool.
+install -d "${DSTROOT}/usr/lib/cron"
+install -m 644 "${SRCROOT}/cron.deny" "${DSTROOT}/usr/lib/cron/cron.deny"
 
-mkdir -p "${DSTROOT}/private/var/at/tabs"
-mkdir -p "${DSTROOT}/private/var/at/tmp"
-chmod 700 "${DSTROOT}/private/var/at/tabs" "${DSTROOT}/private/var/at/tmp"
+mkdir -p "${DSTROOT}/usr/lib/cron/tabs"
+mkdir -p "${DSTROOT}/usr/lib/cron/tmp"
+chmod 700 "${DSTROOT}/usr/lib/cron" "${DSTROOT}/usr/lib/cron/tabs" "${DSTROOT}/usr/lib/cron/tmp"
 
 mkdir -p "${DSTROOT}/usr/local/OpenSourceVersions"
 install -m 0444 "${SRCROOT}/cron.plist" "${DSTROOT}/usr/local/OpenSourceVersions/cron.plist"
