<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT OR Apache-2.0 -->
<!-- Distributed notifications between root's processes (the service's root instance). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.finch.distnoted.root</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/finch-distnoted</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.finch.distnoted</key>
		<true/>
	</dict>
</dict>
</plist>
