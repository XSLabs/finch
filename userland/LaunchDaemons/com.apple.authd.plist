<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT OR Apache-2.0 -->
<!-- Finch's authorization service, started when a process first asks. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.authd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/authd</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.authd</key>
		<true/>
	</dict>
</dict>
</plist>
