#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# Finch boot script, run once by finch-init before the console shell starts.
set -e

# A configured image must mount and check its data volume before looking up
# account names or starting services. Account links also mark such an image:
# losing its volume setting must not silently send user data back into RAM.
persistent_data=0
if [ -e /private/etc/finch/data-volume ] || [ -L /private/etc/finch/data-volume ] ||
   [ -L /private/etc/master.passwd ] || [ -L /private/etc/passwd ] ||
   [ -L /private/etc/group ]; then
    /usr/sbin/finch-data-volume
    persistent_data=1
fi

# The VM's root is a read-only APFS ramdisk (APFS refuses to remount it
# read-write). As in macOS recovery, the writable directories get tmpfs. The
# kernel's System Policy (the sandbox's platform profile) refuses mounts over
# /private/var itself and over /private/var/db, so each other writable /var
# subdirectory gets its own. Mount points are created at image build time
# (tools/vm/mkramdisk.sh).
for dir in /private/tmp /private/var/tmp /private/var/run /private/var/log; do
    mount_tmpfs "$dir"
done
if [ "$persistent_data" = 0 ]; then
    mount_tmpfs /private/var/root
    mount_tmpfs /private/var/rw
fi
chown root:wheel /private/tmp /private/var/tmp /private/var/run /private/var/log \
    /private/var/root /private/var/rw
chmod 1777 /private/tmp /private/var/tmp
# Only root may replace service state or resolver files in these folders.
chmod 755 /private/var/run /private/var/log
# Per-user temporary and cache directories (dirhelper's /var/folders). System
# Policy refuses tmpfs there too, so the image links it into /private/var/tmp.
mkdir -p /private/var/tmp/folders && chmod 755 /private/var/tmp/folders
# /var/db, the daemons' state, is a link into /private/var/rw for the same
# reason, and so is /Users (home directories).
mkdir -p /private/var/rw/db /private/var/rw/Users
# An image whose /Library is on the data volume (tools/vm/mkpersistent.sh):
# a volume laid out before that change gets its folders here.
if [ "$persistent_data" = 1 ] && [ -L /Library ]; then
    mkdir -p /private/var/rw/Library/Preferences/SystemConfiguration
    chown root:wheel /private/var/rw/Library /private/var/rw/Library/Preferences \
        /private/var/rw/Library/Preferences/SystemConfiguration
    chmod 755 /private/var/rw/Library /private/var/rw/Library/Preferences \
        /private/var/rw/Library/Preferences/SystemConfiguration
fi
# The time-zone database is in the image at /usr/share/zoneinfo; macOS (and
# CoreFoundation, and /etc/localtime) look in /var/db/timezone/zoneinfo.
mkdir -p /private/var/rw/db/timezone
ln -sfn /usr/share/zoneinfo /private/var/rw/db/timezone/zoneinfo
chmod 755 /private/var/rw /private/var/rw/db /private/var/rw/Users
chmod 750 /private/var/root
# The read-only image holds cron's defaults; its spool lives with writable state.
if [ -d /usr/share/finch/cron ] && [ ! -d /private/var/rw/cron ]; then
    cp -R /usr/share/finch/cron /private/var/rw/cron
    chown -R root:wheel /private/var/rw/cron
    chmod 755 /private/var/rw/cron
    chmod 700 /private/var/rw/cron/tabs /private/var/rw/cron/tmp
    mkdir -p /private/var/rw/cron/jobs /private/var/rw/cron/spool
    chown daemon:daemon /private/var/rw/cron/jobs /private/var/rw/cron/spool
    chmod 755 /private/var/rw/cron/jobs /private/var/rw/cron/spool
fi

# Home directories with macOS's standard folders (its User Template's): apps
# expect ~/Library and the rest to be there (Stickies makes ~/Library/Stickies,
# not its parents).
make_home() {   # make_home DIR OWNER
    # macOS's modes: the folders are private to their owner, except Public and
    # its Drop Box (others may look in Public and drop files into the box).
    for sub in Desktop Documents Downloads Movies Music Pictures \
               Library "Library/Application Support" Library/Caches Library/Preferences; do
        mkdir -p "$1/$sub"
        chmod 700 "$1/$sub"
    done
    mkdir -p "$1/Public/Drop Box"
    chmod 755 "$1/Public"
    chmod 733 "$1/Public/Drop Box"
    chown -R "$2" "$1"
}
if [ "$persistent_data" = 0 ]; then
    make_home /private/var/root root:wheel
    make_home /private/var/rw/Users/finchtest finchtest:staff
    chmod 750 /private/var/rw/Users/finchtest
fi

echo "rc: Finch userland coming up"
