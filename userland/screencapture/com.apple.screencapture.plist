<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT OR Apache-2.0 -->
<!-- finch-screencaptured (userland/screencapture): runs Finch's screencapture for apps
     that ask the screen capture service (Apple's Screenshot app). Started on demand. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.screencapture</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/finch-screencaptured</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.screencapture.connection</key>
		<true/>
		<key>com.apple.systemuiserver.screencapture</key>
		<true/>
	</dict>
</dict>
</plist>
