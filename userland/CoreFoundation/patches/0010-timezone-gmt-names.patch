+    int32_t gmtOffset = __tryParseGMTName(name);
+    if (-1 != gmtOffset) {
+        return CFTimeZoneCreateWithTimeIntervalFromGMT(allocator, gmtOffset);
+    }
     CFIndex len = CFStringGetLength(name);
     if (6 == len || 8 == len) {
 	UniChar buffer[8];
