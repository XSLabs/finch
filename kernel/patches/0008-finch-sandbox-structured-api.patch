+static int
+finch_sandbox_check_request(proc_t caller, user_addr_t arg)
+{
+	struct finch_sandbox_check_request request;
+	audit_token_t target_token;
+	proc_t target = NULL;
+	kauth_cred_t caller_cred = NOCRED;
+	kauth_cred_t target_cred = NOCRED;
+	uint32_t result;
+	int error;
+	bool claims_self;
+
+	if (arg == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	error = copyin(arg, &request, sizeof(request));
+	if (error != 0) {
+		return error;
+	}
+	if (request.version != FINCH_SANDBOX_ABI_VERSION || request.size != sizeof(request) ||
+	    request.flags != 0 || request.result_reserved != 0 ||
+	    !finch_sandbox_reserved_zero(request.reserved)) {
+		return EINVAL;
+	}
+	if (request.operation != FINCH_SANDBOX_OP_STATUS &&
+	    request.operation != FINCH_SANDBOX_OP_READ_DATA &&
+	    request.operation != FINCH_SANDBOX_OP_WRITE_DATA) {
+		return EINVAL;
+	}
+	if (request.target_pid <= 0) {
+		return ESRCH;
+	}
+
+	/* Non-root callers may ask only about their own live process. */
+	claims_self = request.target_pid == proc_pid(caller) &&
+	    request.target_pidversion == (uint32_t)proc_pidversion(caller);
+	if (!claims_self) {
+		caller_cred = kauth_cred_proc_ref(caller);
+		if (caller_cred == NOCRED) {
+			return ESRCH;
+		}
+		if (kauth_cred_getuid(caller_cred) != 0) {
+			kauth_cred_unref(&caller_cred);
+			return EPERM;
+		}
+		kauth_cred_unref(&caller_cred);
+	}
+
+	/* Only pid and pidversion are identity data in this request. */
+	bzero(&target_token, sizeof(target_token));
+	target_token.val[5] = (uint32_t)request.target_pid;
+	target_token.val[7] = request.target_pidversion;
+	target = proc_find_audit_token(target_token);
+	if (target == NULL) {
+		return ESRCH;
+	}
+	if (proc_pidversion(target) != (int)request.target_pidversion) {
+		error = ESRCH;
+		goto out;
+	}
+
+	target_cred = kauth_cred_proc_ref(target);
+	if (target_cred == NOCRED) {
+		error = ESRCH;
+		goto out;
+	}
+	/* An exec during the read makes the supplied process identity stale. */
+	if (proc_pidversion(target) != (int)request.target_pidversion) {
+		error = ESRCH;
+		goto out;
+	}
+
+	int profile = finch_sandbox_profile(target_cred);
+	switch (request.operation) {
+	case FINCH_SANDBOX_OP_STATUS:
+		result = (uint32_t)profile;
+		break;
+	case FINCH_SANDBOX_OP_READ_DATA:
+		result = (profile & FINCH_SANDBOX_PROFILE_DENY_READ) != 0 ?
+		    FINCH_SANDBOX_RESULT_DENY : 0;
+		break;
+	case FINCH_SANDBOX_OP_WRITE_DATA:
+		result = (profile & FINCH_SANDBOX_PROFILE_DENY_WRITE) != 0 ?
+		    FINCH_SANDBOX_RESULT_DENY : 0;
+		break;
+	default:
+		error = EINVAL;
+		goto out;
+	}
+
+	error = copyout(&result,
+	    arg + offsetof(struct finch_sandbox_check_request, result),
+	    sizeof(result));
+out:
+	if (target_cred != NOCRED) {
+		kauth_cred_unref(&target_cred);
+	}
+	if (target != NULL) {
+		proc_rele(target);
+	}
+	return error;
+}
